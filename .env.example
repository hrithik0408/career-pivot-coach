# ==========================================
# Career Pivot Coach - Local Environment Variables
# ==========================================
# Copy or rename this file to .env.local to activate live Gemini AI evaluation:
# cp .env.example .env.local
#
# IMPORTANT:
# - .env.local is ignored by git and stays strictly on your local machine.
# - Never commit your real API key or share it in chat.
# - The key is read exclusively on the server in /app/api/analyze, /app/api/plan, and /app/api/interview.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model selection
# Recommended options:
# - gemini-3.5-flash (Default: Fast, latest structured reasoning)
# - gemini-3.5-flash-lite (High-speed, low latency fallback)
# - gemini-2.5-flash (Standard fallback)
GEMINI_MODEL=gemini-3.5-flash
